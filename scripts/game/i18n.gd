extends RefCounted
## Tiny translation layer. Code keeps writing Thai text and wraps it in L.t(); the Thai text is the key
## into i18n_table.gd (generated by tools/strings.py). Unknown text falls back to the Thai original.

const Table := preload("res://scripts/game/i18n_table.gd")
const SAVE_PATH := "user://settings.cfg"
const FONT_PATH := "res://assets/fonts/ui_font.tres"
const LANGS := ["th", "en", "de", "nl", "ja", "zh"]
const FLAGS := {
	"th": "res://assets/flags/th.png", "en": "res://assets/flags/en.png", "de": "res://assets/flags/de.png",
	"nl": "res://assets/flags/nl.png", "ja": "res://assets/flags/ja.png", "zh": "res://assets/flags/zh.png",
}

static var lang := ""


static func t(text: String) -> String:
	if lang == "":
		load_saved()
	var row = Table.TABLE.get(text)
	if lang == "th":
		return row[5] if row != null and row.size() > 5 else text
	if row == null:
		return text
	return row[LANGS.find(lang) - 1]


static func load_saved() -> void:
	var cfg := ConfigFile.new()
	var saved := ""
	if cfg.load(SAVE_PATH) == OK:
		saved = str(cfg.get_value("ui", "lang", ""))
	if saved == "":
		var os_lang := OS.get_locale_language()
		saved = os_lang if os_lang in LANGS else "en"
	_apply(saved)


static func set_lang(code: String) -> void:
	_apply(code)
	var cfg := ConfigFile.new()
	cfg.load(SAVE_PATH)
	cfg.set_value("ui", "lang", code)
	cfg.save(SAVE_PATH)


## Japanese and Chinese share many characters but draw some differently, so the
## font for the chosen language goes first in the fallback list.
static func _apply(code: String) -> void:
	lang = code if code in LANGS else "en"
	var font: FontVariation = load(FONT_PATH)
	var thai: Font = load("res://assets/fonts/noto-sans-thai-600.woff2")
	var ja: Font = load("res://assets/fonts/noto-sans-ja-600.woff2")
	var zh: Font = load("res://assets/fonts/noto-sans-zh-600.woff2")
	var list: Array[Font] = []
	list.append_array([thai, zh, ja] if lang == "zh" else [thai, ja, zh])
	font.fallbacks = list


static func is_cjk() -> bool:
	if lang == "":
		load_saved()
	return lang in ["ja", "zh"]
